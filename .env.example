API_PORT=4000
NODE_ENV=development
# Comma-separated allowed origins (single value is okay)
FRONTEND_ORIGIN=http://localhost:8080
SESSION_SECRET=replace-with-long-random-secret
ADMIN_LOGIN=admin
# Generate hash with: node -e "import('bcryptjs').then(b=>b.hash('your_password',10).then(console.log))"
ADMIN_PASSWORD_HASH=
# Supabase (required in Vercel production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table name (default: site_content)
SUPABASE_CONTENT_TABLE=site_content

