API_PORT=4000
NODE_ENV=development
# Comma-separated allowed origins (single value is okay)
FRONTEND_ORIGIN=http://localhost:8080
SESSION_SECRET=replace-with-long-random-secret
ADMIN_LOGIN=admin
# Generate hash with: node -e "import('bcryptjs').then(b=>b.hash('your_password',10).then(console.log))"
ADMIN_PASSWORD_HASH=
# Supabase (required in Vercel production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table name (default: site_content)
SUPABASE_CONTENT_TABLE=site_content

# Telegram: заявки с формы опроса (секреты не коммитить)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Куда слать заявку с фронта: по умолчанию в dev — Node API, в production build — /telegram.php
# VITE_LEAD_SUBMIT_URL=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Лимит заявок с одного IP (Node API): 1 заявка за окно
LEAD_RATE_MAX=1
LEAD_RATE_WINDOW_MS=600000

