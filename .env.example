API_PORT=4000
NODE_ENV=development
# Comma-separated allowed origins (single value is okay)
FRONTEND_ORIGIN=http://localhost:8080
SESSION_SECRET=replace-with-long-random-secret
ADMIN_LOGIN=admin
# Generate hash with: node -e "import('bcryptjs').then(b=>b.hash('your_password',10).then(console.log))"
ADMIN_PASSWORD_HASH=
DB_PATH=server/data/site-content.db
# Required in production for persistent sessions
# REDIS_URL=redis://localhost:6379

